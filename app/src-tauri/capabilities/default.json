{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "reward-overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/Deftera186/tennoscope/issues/**" }] },
    { "identifier": "opener:allow-reveal-item-in-dir", "allow": [{ "path": "$APPDATA/reports/**" }] },
    "clipboard-manager:allow-write-text"
  ]
}
