{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TennoScope",
  "mainBinaryName": "tennoscope",
  "version": "0.3.0",
  "identifier": "io.github.deftera186.tennoscope",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TennoScope — Local-first Warframe Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "reward-overlay",
        "title": "TennoScope — Reward Advisor",
        "url": "/overlay",
        "width": 1100,
        "height": 190,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://raw.githubusercontent.com; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/Deftera186/tennoscope",
    "publisher": "Deftera186",
    "shortDescription": "Local-first Warframe collection and relic companion",
    "longDescription": "TennoScope reads a running Warframe process without modifying it and keeps a local copy of your collection. When a relic cracks it recognises the four rewards on screen and prices them in platinum and ducats from warframe.market, counting only sellers who are online. No account, no telemetry, no Overwolf.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "linux": {
      "deb": {
        "recommends": [
          "x11-utils",
          "imagemagick",
          "tesseract-ocr",
          "tesseract-ocr-eng"
        ]
      },
      "rpm": {
        "recommends": [
          "/usr/bin/xwininfo",
          "/usr/bin/magick",
          "/usr/bin/import",
          "/usr/bin/tesseract"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
