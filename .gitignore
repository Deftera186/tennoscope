# Build output
target/
app/node_modules/
app/dist/

# Local databases
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local tooling state
.repo-git/
.superpowers/
.worktrees/
.claude/
.impeccable/
__pycache__/

# Third-party tool output
Extracted/
# The Windows bundle's vendored Tesseract, fetched by scripts/vendor-windows-tesseract.ps1. The
# directory itself is tracked because tauri.windows.conf.json globs it and a glob that matches
# nothing is a build error, not an empty resource set.
app/src-tauri/vendor/tesseract/*
!app/src-tauri/vendor/tesseract/.gitkeep
