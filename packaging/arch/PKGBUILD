# Maintainer: Deftera186 <https://github.com/Deftera186/tennoscope/issues>
pkgname=tennoscope
pkgver=0.14.0
pkgrel=1
pkgdesc='Local-first Linux Warframe collection and relic companion'
arch=('x86_64')
url='https://github.com/Deftera186/tennoscope'
license=('GPL-3.0-only')
# gtk3 and webkit2gtk-4.1 drag most of the rest in transitively, but the binary links these
# directly (namcap flags them as "implicitly satisfied"), so name them rather than rely on
# another package's dependency list not changing. libpipewire/libxcb/mesa/wayland are the
# capture paths; xdg-utils is tauri-plugin-opener shelling out to xdg-open from Diagnostics.
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'gtk3' 'hicolor-icon-theme' 'libpipewire' 'libsoup3'
         'libxcb' 'mesa' 'wayland' 'webkit2gtk-4.1' 'xdg-utils')
# The relic overlay shells out to tesseract; the collection browser works without it. Wine
# virtual-desktop child discovery shells out to xwininfo; ordinary window discovery stays
# in-process.
optdepends=(
  'tesseract: read the reward card titles for the relic overlay'
  'tesseract-data-eng: English data for reward card recognition'
  'xorg-xwininfo: find Warframe inside a Wine virtual desktop'
)
# Beyond the toolchain, these are xcap's: its Linux capture path depends on pipewire
# unconditionally for the portal route and generates the bindings with bindgen (hence clang), and
# libglvnd supplies egl.pc. Nothing in depends pulls either in, so without them build() dies in
# libspa-sys' build script -- on a desktop machine they happen to be present already, which is why
# this was invisible in review and only broke on a clean install.
makedepends=('cargo' 'clang' 'libglvnd' 'libpipewire' 'nodejs' 'pnpm')
# check() runs the reward-reader tests, which shell out to tesseract for real.
checkdepends=('tesseract' 'tesseract-data-eng')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7386d0325ab116324d3c12954eb15825e58084e623c5e7811f68c2b23119a3a0')

# makepkg.conf ships `lto` in OPTIONS by default, which puts -flto=auto in CFLAGS. That applies to
# the C rusqlite bundles (sqlite3.c), and GCC then emits .gnu.lto_* IR instead of machine code.
# rustc links with ld.lld, which cannot read those sections, so the link fails with ~20 undefined
# sqlite3_* symbols. Rust's own LTO is set by the Cargo profile, not CFLAGS, so nothing is lost.
options=('!lto')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  pnpm --dir app install --frozen-lockfile
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  pnpm --dir app build
  # tauri/custom-protocol is mandatory: without it generate_context!() bakes in the dev-server
  # URL and the release binary opens a connection-refused WebView.
  cargo build --release --locked -p tennoscope --features tauri/custom-protocol
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  RUSTFLAGS="${RUSTFLAGS:-} -C debug-assertions=on" \
    cargo test --workspace --locked
  pnpm --dir app check
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "${srcdir}/target/release/tennoscope" "${pkgdir}/usr/bin/tennoscope"
  install -Dm644 packaging/tennoscope.desktop "${pkgdir}/usr/share/applications/tennoscope.desktop"
  install -Dm644 app/src-tauri/icons/128x128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/tennoscope.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"
}
