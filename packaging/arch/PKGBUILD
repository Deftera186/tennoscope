pkgname=tennoscope
pkgver=0.6.0
pkgrel=1
pkgdesc='Local-first Linux Warframe collection and relic companion'
arch=('x86_64')
url='https://github.com/Deftera186/tennoscope'
license=('GPL-3.0-only')
depends=('glib2' 'gtk3' 'libsoup3' 'webkit2gtk-4.1')
# The relic overlay shells out to tesseract; the collection browser works without it. Window
# location and the crop pipeline used to be xwininfo and ImageMagick and are now in-process.
optdepends=(
  'tesseract: read the reward card titles for the relic overlay'
  'tesseract-data-eng: English data for reward card recognition'
)
makedepends=('cargo' 'nodejs' 'pnpm')
# check() runs the reward-reader tests, which shell out to tesseract for real.
checkdepends=('tesseract' 'tesseract-data-eng')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  pnpm --dir app install --frozen-lockfile
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  pnpm --dir app build
  # tauri/custom-protocol is mandatory: without it generate_context!() bakes in the dev-server
  # URL and the release binary opens a connection-refused WebView.
  cargo build --release --locked -p tennoscope --features tauri/custom-protocol
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo test --workspace --locked
  pnpm --dir app check
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "${srcdir}/target/release/tennoscope" "${pkgdir}/usr/bin/tennoscope"
  install -Dm644 packaging/tennoscope.desktop "${pkgdir}/usr/share/applications/tennoscope.desktop"
  install -Dm644 app/src-tauri/icons/128x128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/tennoscope.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"
}
